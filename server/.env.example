# Deployment configuration. Replace examples with platform values; do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_KEY=replace-with-the-same-random-secret-as-the-ai-service
AI_SERVICE_URL=https://your-ai-service-url
CORS_ALLOWED_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# OAuth provider credentials. Keep actual secrets in server/.env only.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Payment provider sandbox credentials. Keep real credentials in server/.env only.
VNPAY_TMN_CODE=your-vnpay-terminal-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Configure this public HTTPS callback URL in the VNPay merchant portal.
VNPAY_IPN_URL=https://your-public-https-domain/api/payments/vnpay/ipn

MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_IPN_URL=https://your-public-https-domain/api/payments/momo/ipn
MOMO_REQUEST_TYPE=captureWallet

ZALOPAY_APP_ID=your-zalopay-app-id
ZALOPAY_KEY1=your-zalopay-key1
ZALOPAY_KEY2=your-zalopay-key2
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://your-public-https-domain/api/payments/zalopay/callback
